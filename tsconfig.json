{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],

    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "verbatimModuleSyntax": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,

    "resolveJsonModule": true,
    "skipLibCheck": true,
    "declaration": true,

    "rootDir": ".",
    "outDir": "dist",

    "noEmit": false
  },
  "include": ["generate.ts"]
}
